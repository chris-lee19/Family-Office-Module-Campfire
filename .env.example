# Copy to .env for local development. Never commit .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
# Comma-separated Fernet keys (first one encrypts). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In DEBUG a key is derived from DJANGO_SECRET_KEY when this is empty.
FIELD_ENCRYPTION_KEYS=
# Postgres in production; SQLite is used when empty.
DATABASE_URL=

# Public HTTPS URL Campfire uses to reach this app (your ngrok URL in development).
APP_URL=https://your-subdomain.ngrok-free.app

# Campfire (sandbox or production). Values come from Developer -> Apps in Campfire.
CAMPFIRE_BASE_URL=https://api.meetcampfire.com
CAMPFIRE_FRONTEND_ORIGIN=https://app.meetcampfire.com
CAMPFIRE_CLIENT_ID=
CAMPFIRE_CLIENT_SECRET=
CAMPFIRE_SIGNING_SECRET=
# Only during a signing-secret rotation:
CAMPFIRE_SIGNING_SECRET_PREVIOUS=
# Space-separated OAuth scopes: the manifest's allowed_scopes (permission ceiling). Leave empty for the default
# P1 set in config/settings.py (docs/campfire_permissions.md).
CAMPFIRE_SCOPES=
# draft (default): connections request journal_entries:draft and bills:draft, so app-created entries go to
# Campfire approval. direct: request write.
CAMPFIRE_POSTING_MODE=draft
# Admin API key for scripted sandbox configuration / demo seeding only (optional).
CAMPFIRE_API_KEY=
